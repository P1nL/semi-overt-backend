# Copy this file to .runtime/docker-demo.env, or run scripts/docker-demo.ps1 init.
BACKEND_IMAGE=ghcr.io/p1nl/semi-overt-backend:demo
FRONTEND_IMAGE=ghcr.io/p1nl/semi-overt-frontend:demo
APP_PORT=18000
GATEWAY_PORT=18080
MAILPIT_PORT=18025
ADMINER_PORT=18026
RABBITMQ_USERNAME=semi_overt
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
DB_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-a-long-random-password
JWT_SIGN_KEY=replace-with-base64-for-at-least-32-random-bytes
INTERNAL_TOKEN=replace-with-a-long-random-token
RESET_CODE_PEPPER=replace-with-a-long-random-token

# DeepSeek via LangChain4j (server-only). Only the API key is required; keep it in the ignored env file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PROXY_URL=
# Legacy AI_POLISH_* overrides remain supported. ENDPOINT is a full chat/completions URL.
AI_POLISH_ENDPOINT=
AI_POLISH_API_KEY=
AI_POLISH_MODEL=
AI_POLISH_TIMEOUT_SECONDS=45
AI_POLISH_MAX_TOKENS=8192
