# Runtime baseline
# Cloud-side configuration is sourced from environment variables plus Nacos.
# Do not rely on local-only profile files or local filesystem paths in server environments.

# Shared runtime profile
SPRING_PROFILES_ACTIVE=server

# Service discovery and config
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-your-namespace-id

# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/content_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch
ELASTICSEARCH_URIS=http://127.0.0.1:9200

# JWT
JWT_SIGN_KEY=replace-me
JWT_EXPIRATION=120
JWT_REMEMBER_ME_EXPIRATION=10080
JWT_REFRESH_THRESHOLD=30

# Auth and notification
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
FRONTEND_BASE_URL=https://example.com
RESET_PWD_TOKEN_TTL_MINUTES=15

# Content
SUBMIT_REVIEW_COOLDOWN_MINUTES=30
DRAFT_CACHE_TTL_DAYS=7
DRAFT_FLUSH_INTERVAL_MINUTES=5
EVENT_OUTBOX_PUBLISH_DELAY_MS=5000
EVENT_RETRY_DELAY_MS=30000
EVENT_CONSUMER_MAX_RETRIES=3

# File storage
STORAGE_UPLOAD_PATH=/data/now-demo/uploads
STORAGE_ACCESS_PREFIX=/static/uploads
STORAGE_MAX_FILE_SIZE=10485760

# Optional single-service port override
# SERVER_PORT=8080
